# ---- Core -------------------------------------------------------------------------------
APP_ENV=development
# Local: SQLite file. Production: your Supabase Postgres connection string (Settings → Database).
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./data/workflowwise.db
# Create tables on startup (fine for SQLite/dev). For Supabase, apply supabase/migrations instead and set false.
AUTO_CREATE_TABLES=true
CORS_ORIGINS=http://localhost:3000

# ---- Auth ---------------------------------------------------------------------------------
# dev      = accepts "Bearer dev:<email>" (local only, refused when APP_ENV=production)
# supabase = verifies Supabase access tokens (JWKS, or SUPABASE_JWT_SECRET for legacy HS256 projects)
AUTH_MODE=dev
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Storage ------------------------------------------------------------------------------
STORAGE_BACKEND=local          # local | supabase
LOCAL_STORAGE_DIR=./data/uploads
SUPABASE_STORAGE_BUCKET=documents

# ---- AI -------------------------------------------------------------------------------------
# auto = Gemini when GEMINI_API_KEY is set, otherwise the offline local providers.
LLM_PROVIDER=auto              # auto | gemini | local
EMBEDDING_PROVIDER=auto        # auto | gemini | local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must match the vector(N) columns in the database. Changing providers requires re-embedding (reprocess docs).
EMBEDDING_DIM=768

# ---- Background jobs ------------------------------------------------------------------------
# Set to use Redis + RQ (run `python worker.py`). Empty = ingestion runs in-process after the response.
REDIS_URL=

STALE_AFTER_DAYS=120
